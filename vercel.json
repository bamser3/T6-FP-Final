{
  "version": 2,
  "builds": [
    { 
      "src": "backend/wsgi.py", 
      "use": "@vercel/python",
      "config": { "maxLambdaSize": "15mb" }
    },
    { "src": "frontend/dist/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "backend/wsgi.py" },
    { "src": "/(.*)", "dest": "frontend/dist/$1" }
  ]
}