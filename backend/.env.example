# ─────────────────────────────────────────────
#  TechExtract — Backend Environment Variables
#  Copy this file to .env and fill in your values
# ─────────────────────────────────────────────

# PostgreSQL connection string
# Format: postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/flashcard_db

# Secret key for JWT tokens and sessions — change this to something random
SESSION_SECRET=change-this-to-a-random-secret-string

# Groq API key for AI skill extraction
# Get one free at https://console.groq.com
GROQ_API_KEY=your-groq-api-key-here

# Port the backend listens on (default 8080)
PORT=8080
